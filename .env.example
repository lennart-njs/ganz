# Reparatur-Assistent: Schlüssel für die Claude API (console.anthropic.com).
# Kopiere diese Datei nach .env und trag den Schlüssel ein. .env wird nicht committet.
# Kein EXPO_PUBLIC_ davor: Der Schlüssel bleibt auf dem Rechner und kommt nie in die App.
ANTHROPIC_API_KEY=

# Pitch-Token für die Chat-Route (nur Server). Ist er gesetzt, beantwortet die Route nur Anfragen
# mit diesem Token, sonst 401. Mehrere Token mit Komma getrennt gelten nebeneinander, so rotiert er:
# neuen dazu, neuen Build verteilen, alten entfernen. Leer: keine Prüfung (Entwicklung).
# Der Token begrenzt Missbrauch, ist aber kein Schutz. Er steckt in der App und lässt sich auslesen.
CHAT_PITCH_TOKEN=

# Adresse des Servers mit der Chat-Route, ohne /api/chat, z. B. https://chat.example.org
# Leer: Die App fragt den Dev-Server, von dem sie geladen ist. Das geht nur mit `npx expo start`.
EXPO_PUBLIC_API_URL=

# Derselbe Token für die App. EXPO_PUBLIC_ heißt: Er landet im App-Bundle. Nie ein Geheimnis hier.
EXPO_PUBLIC_CHAT_TOKEN=

# Grenzen der Chat-Route (nur Server, im Speicher je Prozess). Leer: 10 je Minute und 200 am Tag
# je IP-Adresse und Installation, 1000 am Tag insgesamt. Darüber antwortet die Route mit 429.
CHAT_RATE_PER_MINUTE=
CHAT_RATE_PER_DAY=
CHAT_DAILY_LIMIT=

# Build-Variante: development (Standard), pitch oder production. Wählt in app.config.ts Name,
# Bundle-ID, Update-Kanal und Laufzeit. Für Builds setzt eas.json den Wert, für `eas update` die
# EAS-Umgebung (--environment). Ein unbekannter Wert bricht ab.
APP_VARIANT=
# Dieselbe Variante im App-Bundle. Leer lassen oder gleich APP_VARIANT, sonst bricht die
# Konfiguration ab. Kein Geheimnis: EXPO_PUBLIC_ landet im Bundle.
EXPO_PUBLIC_APP_VARIANT=
